# Example environment file for ClimaStat Backend
# Copy this file to .env or .env.dev and update values as needed

# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Backend settings
BACKEND_PORT=4000
DB_SSL=false

# Adminer UI
ADMINER_PORT=8080

# Optional: Custom database URL (Docker uses service name 'db')
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
