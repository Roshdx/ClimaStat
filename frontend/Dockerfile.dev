# frontend/Dockerfile.dev — development image (vite hot reload)
FROM node:22-alpine

WORKDIR /app
ENV PATH /app/node_modules/.bin:$PATH

# Install dependencies (cache)
COPY package.json package-lock.json ./
RUN npm ci

# Copy everything (we mount local files with volumes in compose but keep copy for build)
COPY . .

# Expose the vite dev server port
EXPOSE 5173

# Use an environment variable for API base (will be provided by .env or compose)
ENV VITE_API_BASE=${VITE_API_BASE:-http://localhost:4000}

# Default dev command: run vite dev server bound to 0.0.0.0 so container is accessible
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
